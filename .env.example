# ---------------------------------------------------------------------------
# Folio 译坊 — copy to .env and edit
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8090
APP_DB_PATH=data/folio.db
APP_UPLOAD_ROOT=data/uploads
APP_EXPORT_ROOT=data/exports
APP_ASSET_ROOT=data/assets

# Optional server-side reference shelf. Only direct children are importable.
REFERENCE_BOOKS_DIR=~/books/ocr1

# mini-harness (proj05). Create a dedicated harness user and paste its key here.
HARNESS_BASE_URL=http://127.0.0.1:8000
HARNESS_API_KEY=hx_replace_me
HARNESS_MODEL=deepseek-flash
HARNESS_TIMEOUT_SECONDS=900
HARNESS_FAST_URL=http://127.0.0.1:8001
HARNESS_MODELS=deepseek-v4.1-flash,deepseek-flash,deepseek-v4-pro,glm-5.3-flash,glm-5.3,minimax-m3

MAX_UPLOAD_MB=100
MAX_SOURCE_SEGMENTS=20000
TRANSLATION_GROUP_CHARS=4200
TRANSLATION_CONCURRENCY=6
TRANSLATION_MAX_RETRIES=2
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=zh-CN

# Local demo account. Change the password before exposing the service.
DEMO_EMAIL=demo@folio.local
DEMO_PASSWORD=folio2026
SESSION_DAYS=30

# AI vision OCR for scanned / formula-heavy PDFs
VISION_OCR_MODEL=deepseek-flash
VISION_OCR_DPI=180
VISION_OCR_CONCURRENCY=4
VISION_OCR_MAX_PAGES=2000
VISION_OCR_MAX_TOKENS=24000

# Optional bundled DjVu decoder (ddjvu)
DJVU_BIN=vendor/djvulibre/bin/ddjvu

# Blue/green: second instance must not mark another process's running jobs failed.
APP_SKIP_RECOVERY=0
